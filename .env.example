# Copy to .env.local for local development and set the same keys in the host's
# environment settings (Vercel -> Project -> Settings -> Environment Variables).
# Never commit real values.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------

# REQUIRED before launch. The canonical production origin, no trailing slash.
# Canonical tags, the sitemap, Open Graph URLs and schema @ids are built from
# it. Unset, it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Indexing is OPT-IN. Anything other than exactly "true" makes robots.txt
# return "Disallow: /" and adds a noindex meta tag to every page, so a preview
# or demo deployment can never be indexed. Set to "true" on launch day only.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Shows the dashed "awaiting content" notes (reviews, project photos, bio)
# on a deployed build. They always show in `npm run dev` and are hidden in
# production builds unless this is "true". Handy for a client review link.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# ---------------------------------------------------------------------------
# Estimate form delivery (src/app/api/estimate/route.ts) — SERVER ONLY
#
# Until RESEND_API_KEY and CONTACT_INBOX are both set, the form validates and
# then tells the visitor honestly that online requests are not connected yet
# and to call or text instead. It never claims a request was sent when it
# was not. Check status any time at /api/estimate (GET).
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com). The key already used on the Flourish Now
# project works here too, as long as MAIL_FROM is on a domain verified there.
RESEND_API_KEY=

# Where estimate requests are delivered: Matt's inbox.
CONTACT_INBOX=

# Verified sender. Must be on a domain verified in Resend.
# Example: TrueCraft website <estimates@flourishnowdigital.com>
MAIL_FROM=

# ---------------------------------------------------------------------------
# Analytics — optional. Nothing loads unless these are set.
# ---------------------------------------------------------------------------

# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Search Console HTML-tag verification: the `content` value only.
NEXT_PUBLIC_GSC_VERIFICATION=
